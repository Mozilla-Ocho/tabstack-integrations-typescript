{
  "name": "@tabstack/pi-agent",
  "version": "0.1.0",
  "description": "Tabstack tools for the Pi coding agent: cited answers, clean Markdown, matching JSON, and completed public web tasks from the live web, backed by the official Tabstack SDK. Never trained on. Private by default. Built by Mozilla.",
  "author": "Tabstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mozilla-Ocho/tabstack-integrations-typescript.git",
    "directory": "packages/pi-agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm -w run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "tabstack",
    "mozilla",
    "web-research",
    "web-access",
    "research",
    "extraction",
    "markdown",
    "json"
  ],
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "dependencies": {
    "@tabstack/sdk": "^2.6.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@tabstack/integrations-core": "workspace:*",
    "tsup": "^8.3.5",
    "typebox": "^1.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
