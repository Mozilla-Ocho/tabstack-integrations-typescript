{
  "name": "@tabstack/pi-agent",
  "version": "0.1.0",
  "description": "Tabstack tools for the Pi coding agent as a Pi extension. Schema-enforced web extraction and research, backed by the official Tabstack SDK.",
  "author": "Tabstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mozilla-Ocho/tabstack-integrations-typescript.git",
    "directory": "packages/pi-agent"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "tabstack",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "extension",
    "tools",
    "agent",
    "web-scraping",
    "extraction"
  ],
  "dependencies": {
    "@tabstack/sdk": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "typebox": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@tabstack/integrations-core": "workspace:*",
    "tsup": "^8.3.5",
    "typebox": "^1.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.0.0"
  }
}
