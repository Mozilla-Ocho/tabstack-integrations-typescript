{
  "name": "@tabstack/mastra",
  "version": "0.1.0",
  "description": "Tabstack tools for the Mastra agent framework. Cited research, clean page content, JSON that matches your schema, and browser tasks, backed by the official Tabstack SDK.",
  "author": "Tabstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mozilla-Ocho/tabstack-integrations-typescript.git",
    "directory": "packages/mastra"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm -w run build"
  },
  "keywords": [
    "tabstack",
    "mastra",
    "tools",
    "agent",
    "web-research",
    "web-extraction",
    "browser-automation",
    "extraction"
  ],
  "dependencies": {
    "@tabstack/sdk": "^2.6.1"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.51.0",
    "@tabstack/integrations-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.0.0"
  }
}
