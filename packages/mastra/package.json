{
  "name": "@tabstack/mastra",
  "version": "0.1.0",
  "description": "Tabstack tools for the Mastra agent framework. Schema-enforced web extraction and research, backed by the official Tabstack SDK.",
  "author": "Tabstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mozilla-Ocho/tabstack-integrations-typescript.git",
    "directory": "packages/mastra"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["tabstack", "mastra", "tools", "agent", "web-scraping", "extraction"],
  "dependencies": {
    "@tabstack/sdk": "^2.6.1"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.51.0",
    "@tabstack/integrations-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.0"
  }
}
